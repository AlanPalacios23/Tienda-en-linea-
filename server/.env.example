PORT=8080
DATABASE_URL=postgresql://nox:nox_local_only@localhost:5432/nox
PUBLIC_BASE_URL=http://localhost:8080
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_ENABLED=false
ALLOW_LIVE_CHECKOUT=false
# Centavos MXN, explícitamente 0 si envío gratis.
# ID del código promocional NOXTALA creado en Stripe TEST (20.04% once).
# Debe verificarse primero en sandbox. No exponer claves.
STRIPE_NOXTALA_PROMO_ID=
TRUST_PROXY=false
NODE_ENV=development

# Habilitar SOLO cuando logística de esta zona esté comprobada.
DHL_READY=false
TALA_VIP_READY=false
